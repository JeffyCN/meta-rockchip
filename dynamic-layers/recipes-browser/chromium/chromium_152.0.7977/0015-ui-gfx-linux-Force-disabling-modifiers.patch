From e4a7afed128b84cee9204169feb62f3a3270407c Mon Sep 17 00:00:00 2001
From: Jeffy Chen <jeffy.chen@rock-chips.com>
Date: Mon, 7 Aug 2023 18:05:41 +0800
Subject: [PATCH 15/18] ui: gfx: linux: Force disabling modifiers

It crashes somehow.

Signed-off-by: Jeffy Chen <jeffy.chen@rock-chips.com>
---
 ui/gfx/linux/gbm_wrapper.cc | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/ui/gfx/linux/gbm_wrapper.cc b/ui/gfx/linux/gbm_wrapper.cc
index 6020a6081..40001cd5b 100644
--- a/ui/gfx/linux/gbm_wrapper.cc
+++ b/ui/gfx/linux/gbm_wrapper.cc
@@ -336,7 +336,8 @@ class Device final : public ui::GbmDevice {
       const gfx::Size& requested_size,
       uint32_t flags,
       const std::vector<uint64_t>& modifiers) override {
-    if (modifiers.empty()) {
+    // HACK: Force disabling modifiers
+    if (true || modifiers.empty()) {
       return CreateBuffer(format, requested_size, flags);
     }
 
