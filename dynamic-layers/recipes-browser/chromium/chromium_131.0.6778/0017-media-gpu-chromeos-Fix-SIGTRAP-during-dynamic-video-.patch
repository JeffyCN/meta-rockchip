From c43cd99cf99436a635464c8d70a4090c83d07481 Mon Sep 17 00:00:00 2001
From: Jeffy Chen <jeffy.chen@rock-chips.com>
Date: Tue, 10 Feb 2026 18:19:58 +0800
Subject: [PATCH] media: gpu: chromeos: Fix SIGTRAP during dynamic video
 resolution switching

Signed-off-by: Jeffy Chen <jeffy.chen@rock-chips.com>
---
 media/gpu/chromeos/video_decoder_pipeline.cc     |  2 ++
 media/gpu/chromeos/video_decoder_pipeline.cc.rej | 11 +++++++++++
 2 files changed, 13 insertions(+)
 create mode 100644 media/gpu/chromeos/video_decoder_pipeline.cc.rej

diff --git a/media/gpu/chromeos/video_decoder_pipeline.cc b/media/gpu/chromeos/video_decoder_pipeline.cc
index c00c7b5..9af3286 100644
--- a/media/gpu/chromeos/video_decoder_pipeline.cc
+++ b/media/gpu/chromeos/video_decoder_pipeline.cc
@@ -1115,7 +1115,9 @@ VideoDecoderPipeline::PickDecoderOutputFormat(
     // This is not compatible with VdVideoDecodeAccelerator, which
     // expects GPU buffers in VdVideoDecodeAccelerator::GetPicture()
     frame_converter_->set_get_original_frame_cb(base::NullCallback());
+#if 0 // HACK: Workaround for CHECK(main_frame_pool_) failure during reinit.
     main_frame_pool_.reset();
+#endif
     return *viable_candidate;
   }
 #elif BUILDFLAG(IS_CHROMEOS_LACROS)
diff --git a/media/gpu/chromeos/video_decoder_pipeline.cc.rej b/media/gpu/chromeos/video_decoder_pipeline.cc.rej
new file mode 100644
index 0000000..db16e34
--- /dev/null
+++ b/media/gpu/chromeos/video_decoder_pipeline.cc.rej
@@ -0,0 +1,11 @@
+diff a/media/gpu/chromeos/video_decoder_pipeline.cc b/media/gpu/chromeos/video_decoder_pipeline.cc	(rejected hunks)
+@@ -1142,7 +1142,9 @@ VideoDecoderPipeline::PickDecoderOutputFormat(
+     // This is not compatible with VdVideoDecodeAccelerator, which
+     // expects GPU buffers in VdVideoDecodeAccelerator::GetPicture()
+     frame_converter_->set_get_original_frame_cb(base::NullCallback());
++#if 0 // HACK: Workaround for CHECK(main_frame_pool_) failure during reinit.
+     main_frame_pool_.reset();
++#endif
+     return *viable_candidate;
+   }
+ #elif BUILDFLAG(IS_CHROMEOS)
-- 
2.38.5

