   vmeta = gst_buffer_get_video_meta (buf);
   if (vmeta) {
     finfo = drm_info->vinfo.finfo;
@@ -94,18 +109,13 @@ gst_wl_linux_dmabuf_construct_wl_buffer (GstBuffer * buf,
     nplanes = vmeta->n_planes;
     offsets = vmeta->offset;
